datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  password        String
  name            String
  role            String   @default("APPLICANT") // GUEST, APPLICANT, OFFICER, INSPECTOR, ADMIN
  mobile          String?
  language        String   @default("en")
  highContrast    Boolean  @default(false)
  fontSize        String   @default("normal")
  department      String?
  designation     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organisations   Organisation[]
  projects        Project[]
  applications    Application[]
  documents       Document[]
  inspections     Inspection[]      @relation("InspectorRelation")
  assignedInspections Inspection[]  @relation("OfficerRelation")
  grievances      Grievance[]       @relation("ApplicantGrievance")
  assignedGrievances Grievance[]    @relation("OfficerGrievance")
  notifications   Notification[]
  auditLogs       AuditLog[]
}

model Organisation {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  entityType   String
  panNumber    String?
  gstNumber    String?
  address      String
  district     String
  taluka       String
  state        String   @default("Maharashtra")
  pinCode      String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects     Project[]
  documents    Document[]
}

model Project {
  id                 String   @id @default(uuid())
  organisationId     String
  organisation       Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  sector             String
  subSector          String
  district           String
  taluka             String
  isMIDC             Boolean  @default(true)
  landType           String
  landArea           Float
  builtupArea        Float
  stage              String   @default("SETUP")
  investmentAmount   Float
  workforce          Int
  wasteCategory      String   @default("GREEN")
  hazardousMaterials Boolean  @default(false)
  waterReq           Float    @default(500)
  powerReq           Float    @default(50)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  applications       Application[]
  documents          Document[]
  inspections        Inspection[]
  complianceEvents   ComplianceEvent[]
  renewals           Renewal[]
  schemeMatches      SchemeMatch[]
  grievances         Grievance[]
}

model ApprovalRule {
  id                 String   @id @default(uuid())
  ruleId             String   @unique
  version            Int      @default(1)
  title              String
  sector             String
  subSector          String?
  locationType       String?  // ALL, MIDC, NON_MIDC
  district           String?  // ALL or specific
  projectStage       String?  // ALL, SETUP, CONSTRUCTION, OPERATION
  minInvestment      Float?   @default(0)
  maxInvestment      Float?
  minWorkforce       Int?     @default(0)
  maxWorkforce       Int?
  envCategory        String?  // WHITE, GREEN, ORANGE, RED
  hazardousCondition Boolean? @default(false)
  requiredApproval   String
  department         String
  requiredDocs       String   // JSON string of document names
  dependencies       String?  // JSON array of dependency approval titles
  slaDays            Int      @default(30)
  riskLevel          String   @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  priority           Int      @default(1)
  explanation        String
  sourceRef          String?
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  applications       Application[]
}

model Application {
  id                 String            @id @default(uuid())
  projectId          String
  project            Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId             String
  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvalRuleId     String?
  approvalRule       ApprovalRule?     @relation(fields: [approvalRuleId], references: [id])
  approvalName       String
  department         String
  status             String            @default("NOT_STARTED") // ApplicationStatus string
  submissionDate     DateTime?
  slaDueDate         DateTime?
  riskLevel          String            @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  currentStep        Int               @default(1)
  requiresInspection Boolean           @default(false)
  inspectionStage    String?           @default("before_decision")
  assignedInspectorId String?
  decisionRemarks    String?
  rejectionReason    String?
  approvedByUserId   String?
  approvedAt         DateTime?
  rejectedByUserId   String?
  rejectedAt         DateTime?
  approvalReferenceNumber String?
  isDemoSandboxRecord Boolean          @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  history            ApplicationStatusHistory[]
  queries            Query[]
  inspections        Inspection[]
  documents          DocumentVerification[]
}

model ApplicationStatusHistory {
  id            String            @id @default(uuid())
  applicationId String
  application   Application       @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  status        String
  comment       String?
  changedByUserId String
  createdAt     DateTime          @default(now())
}

model Document {
  id                 String   @id @default(uuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisationId     String?
  organisation       Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)
  projectId          String?
  project            Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name               String
  category           String   @default("IDENTITY")
  fileUrl            String
  fileType           String
  fileSize           Int
  expiryDate         DateTime?
  isVerified         Boolean  @default(false)
  preValidationScore Int      @default(100)
  metadata           String?  // JSON metadata string
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  verifications      DocumentVerification[]
}

model DocumentVerification {
  id            String   @id @default(uuid())
  documentId    String
  document      Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verifiedByUserId String
  status        String   @default("PENDING") // VERIFIED, REJECTED, PENDING
  comment       String?
  createdAt     DateTime @default(now())
}

model Query {
  id            String   @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  raisedByUserId String
  title         String
  description   String
  status        String   @default("OPEN") // OPEN, RESPONDED, CLOSED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  responses     QueryResponse[]
}

model QueryResponse {
  id            String   @id @default(uuid())
  queryId       String
  query         Query    @relation(fields: [queryId], references: [id], onDelete: Cascade)
  respondedByUserId String
  message       String
  attachmentUrl String?
  createdAt     DateTime @default(now())
}

model Inspection {
  id              String           @id @default(uuid())
  applicationId   String
  application     Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  officerId       String?
  officer         User?            @relation("OfficerRelation", fields: [officerId], references: [id], onDelete: SetNull)
  inspectorId     String?
  inspector       User?            @relation("InspectorRelation", fields: [inspectorId], references: [id], onDelete: SetNull)
  scheduledDate   DateTime
  slotTime        String           @default("10:00 AM - 12:00 PM")
  status          String           @default("SCHEDULED") // InspectionStatus string
  locationAddress String
  latitude        Float?
  longitude       Float?
  notes           String?
  reportSummary   String?
  recommendation  String?          // RECOMMEND_APPROVAL, RECOMMEND_REJECTION, REQUIRE_CLARIFICATION
  reportPdfUrl    String?
  completedAt     DateTime?
  cancelledAt     DateTime?
  cancellationReason String?
  isDemoSandboxRecord Boolean       @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  items           InspectionChecklistItem[]
}

model InspectionChecklistItem {
  id              String   @id @default(uuid())
  inspectionId    String
  inspection      Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  category        String
  itemTitle       String
  isCompliant     String   @default("NOT_CHECKED") // COMPLIANT, NON_COMPLIANT, NEEDS_REVIEW, NOT_APPLICABLE
  notes           String?
  evidencePhotoUrl String?
  createdAt       DateTime @default(now())
}

model Scheme {
  id                  String   @id @default(uuid())
  schemeId            String   @unique
  title               String
  department          String
  description         String
  sector              String   @default("ALL")
  minInvestment       Float    @default(0)
  maxInvestment       Float    @default(100000000)
  district            String   @default("ALL")
  benefits            String
  eligibilityCriteria String
  requiredDocs        String
  deadline            DateTime?
  officialUrl         String?
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())

  matches             SchemeMatch[]
}

model SchemeMatch {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schemeId    String
  scheme      Scheme   @relation(fields: [schemeId], references: [id], onDelete: Cascade)
  matchScore  Int      @default(85)
  explanation String
  isSaved     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model ComplianceEvent {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String
  title       String
  department  String
  category    String   @default("FILING")
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  reminderDate DateTime?
  notes       String?
  createdAt   DateTime @default(now())
}

model Renewal {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvalName String
  department   String
  licenseNumber String
  expiryDate   DateTime
  status       String   @default("ACTIVE") // ACTIVE, RENEWAL_DUE, EXPIRED
  reminderDays Int      @default(30)
  createdAt    DateTime @default(now())
}

model Grievance {
  id                String          @id @default(uuid())
  ticketId          String          @unique
  userId            String
  user              User            @relation("ApplicantGrievance", fields: [userId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  category          String
  subject           String
  description       String
  priority          String          @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status            String          @default("OPEN") // OPEN, ACKNOWLEDGED, IN_PROGRESS, ESCALATED, RESOLVED, CLOSED
  officerAssignedId String?
  officerAssigned   User?           @relation("OfficerGrievance", fields: [officerAssignedId], references: [id], onDelete: SetNull)
  isEscalated       Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  messages          GrievanceMessage[]
}

model GrievanceMessage {
  id            String    @id @default(uuid())
  grievanceId   String
  grievance     Grievance @relation(fields: [grievanceId], references: [id], onDelete: Cascade)
  senderUserId  String
  message       String
  attachmentUrl String?
  isInternal    Boolean   @default(false)
  createdAt     DateTime  @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  category  String   @default("GENERAL")
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  details    String?
  ipAddress  String?  @default("127.0.0.1")
  createdAt  DateTime @default(now())
}

model KnowledgeBaseArticle {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  category    String
  content     String
  language    String   @default("en")
  viewCount   Int      @default(0)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model TranslationKey {
  id        String   @id @default(uuid())
  key       String   @unique
  defaultEn String
  mr        String?
  hi        String?
  ur        String?
  category  String   @default("UI")
  updatedAt DateTime @updatedAt
}
