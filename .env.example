# MongoDB Atlas in Production / Local MongoDB for Development
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="udyogsathi"

# Session HMAC Secret Key
SESSION_SECRET="replace_with_a_long_random_hmac_secret"

# Application Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="UdyogSathi"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Demo Mode Indicator
NEXT_PUBLIC_IS_DEMO_MODE="true"

# Optional production file storage
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="uploads"
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
